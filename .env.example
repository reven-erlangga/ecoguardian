# Ecoguard — Environment Template
# Copy file ini jadi `.env` lalu isi nilai-nilainya.
#   cp .env.example .env
#
# File `.env` (di root) dibaca otomatis oleh docker-compose untuk
# variabel `${VAR:-}` yang dipakai di infra/docker-compose.yml.

# ─── Twitter API v2 (twitter-service) ─────────────────────
# Consumer Key & Secret = API Key & Secret Twitter (Twitter API v2).
# Access Token & Secret diperlukan untuk MEMPOSTING reply (OAuth 1.0a),
# di Keys and tokens > Access Token and Secret.
# Biarkan kosong jika tidak dipakai.
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# OAuth 2.0 (user context, bisa write) — dipakai untuk posting auto-reply
TWITTER_OAUTH2_ACCESS_TOKEN=
TWITTER_OAUTH2_REFRESH_TOKEN=
TWITTER_OAUTH2_CLIENT_ID=
TWITTER_OAUTH2_CLIENT_SECRET=

# ─── ImageKit (asset-service) ─────────────────────────────
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
# IMAGEKIT_URL_ENDPOINT=
