    "@graphql-tools/utils": "^11.1.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@whatwg-node/disposablestack": "^0.0.6",
    "@whatwg-node/promise-helpers": "^1.0.0",
    "graphql-scalars": "^1.22.4",
    "lodash.get": "^4.4.2",
    "long": "4.0.0",
    "protobufjs": "^7.5.8",
    "tslib": "^2.4.0"
  },
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-mesh",
    "directory": "packages/transports/grpc"
  },
