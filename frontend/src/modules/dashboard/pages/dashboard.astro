---
import Layout from '@components/templates/AppShell.astro';
import { StatsGrid } from '../components/stats-grid';
import { RecentTweets } from '../components/recent-tweets';
---

<Layout title="Dashboard - Ecoguard">
  <section class="space-y-8">
    <div>
      <h1 class="text-2xl font-bold text-foreground">Dashboard</h1>
      <p class="text-sm text-muted-foreground">Ringkasan aktivitas Ecoguard</p>
    </div>
    <StatsGrid client:load />
    <RecentTweets client:load />
  </section>
</Layout>
