---
import Layout from '@components/templates/AppShell.astro';
import { TweetFilter } from '../components/tweet-filter';
import { TweetFeed } from '../components/tweet-feed';
---

<Layout title="Tweets - Ecoguard">
  <section class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-foreground">Tweets</h1>
      <p class="text-sm text-muted-foreground">Pantau tweet lingkungan dari Twitter</p>
    </div>
    <TweetFilter client:load />
    <TweetFeed client:load />
  </section>
</Layout>
