---
import Layout from '@/layouts/Layout.astro';
import AppShell from '@components/templates/app-shell/app-shell.svelte';
import StatsGrid from '@components/organisms/stats-grid/stats-grid.svelte';
import EmptyState from '@components/empty-state/empty-state.svelte';
---
<Layout title="Dashboard - Ecoguard">
  <AppShell currentPath="/dashboard">
    <div class="space-y-6">
      <div>
        <h1 class="text-3xl font-bold">Dashboard</h1>
        <p class="text-gray-600">Ringkasan aktivitas Ecoguard</p>
      </div>
      <StatsGrid client:load />
      <section class="neo-border bg-white neo-shadow p-6">
        <h3 class="font-bold text-lg mb-4">Tweet Terbaru</h3>
        <EmptyState
          icon="MessageSquareText"
          title="Belum Ada Tweet"
          description="Tweet yang baru masuk akan muncul di sini."
        />
      </section>
    </div>
  </AppShell>
</Layout>
