---
import Layout from '@/layouts/Layout.astro';
import AppShell from '@components/templates/app-shell/app-shell.svelte';
import EmptyState from '@components/empty-state/empty-state.svelte';
---
<Layout title="Blockchain - Ecoguard">
  <AppShell currentPath="/blockchain">
    <div class="space-y-4">
      <h1 class="text-3xl font-bold">Blockchain</h1>
      <p class="text-gray-600">Setiap klasifikasi dan penyelesaian laporan dicatat secara immutable di blockchain.</p>
      <EmptyState 
        icon="Box"
        title="Jelajahi Blockchain"
        description="Data blockchain akan muncul di sini. Jalankan simulasi untuk melihat rantai blok."
        actionLabel="Buka Simulasi"
        actionHref="/simulasi"
      />
    </div>
  </AppShell>
</Layout>
