---
import Layout from '@/layouts/Layout.astro';
import AppShell from '@components/templates/app-shell/app-shell.svelte';
import EmptyState from '@components/empty-state/empty-state.svelte';
---
<Layout title="Notifikasi - Ecoguard">
  <AppShell currentPath="/notifications">
    <div class="space-y-4">
      <h1 class="text-3xl font-bold">Notifikasi</h1>
      <EmptyState 
        icon="Bell"
        title="Tidak Ada Notifikasi"
        description="Notifikasi akan muncul ketika ada laporan baru atau status laporan berubah."
        actionLabel="Ke Dashboard"
        actionHref="/dashboard"
      />
    </div>
  </AppShell>
</Layout>
